# Copy to .env.local and fill in. Never commit .env.local (git-ignored).

# Postgres — local dev database, or the container's connection string in production
DATABASE_URL="postgresql://localhost:5432/ngo_expenses"

# Public origin of the app; shared links (/s/...) are built from it, as are other absolute links.
# Required in production — the app refuses to start without it (D-112). In development, match the
# port the dev server runs on (e.g. http://localhost:3001), or copied share links won't open.
APP_URL="http://localhost:3000"

# Keys session tokens: the database stores an HMAC of the cookie value under this secret.
# Required in production — the app refuses to start without it. Rotating it invalidates
# every session at once, which is the only "sign everybody out" lever there is, so it is
# also the correct response to a suspected cookie compromise. Generate with
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# How many reverse proxies sit in front of the app — Caddy or nginx terminating TLS is 1.
# REQUIRED IN PRODUCTION. Login rate limits are keyed on the client address, and with no
# proxy count the app cannot identify one: every visitor collapses into a single shared
# bucket, so an attacker's wrong guesses lock out the real user. Set it to the number of
# proxies you actually run — a wrong value is worse than none, because a forged
# X-Forwarded-For could then be trusted.
TRUSTED_PROXY_HOPS="0"

# AWS S3 — private bucket, see docs/01-domain/data-model.md §S3 layout. Required in
# production; without it the app refuses to start rather than writing files to local disk.
S3_BUCKET=""
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# Public signup gate (D-15). Defaults to closed, as the architecture specifies. Set it to
# "true" only for the one-time creation of the client's organisation, then set it back —
# this is an internet-facing system holding City of Detroit grant records.
SIGNUP_ENABLED="false"

# Reading amounts from receipts (Phase 10, D-105). Without both a key and a model, the
# feature stays hidden on the expense form — no panel, no Plus upload look, the read route
# refuses with 403 — exactly as if the Settings switch were off. The live .env is never
# updated by a deploy; these must be set there by hand.
OPENAI_API_KEY=""
OPENAI_READ_MODEL="gpt-5.6-luna"

# Optional. Dollars per 1,000,000 tokens, used only to log an estimated cost per read
# (src/services/openai/responses.ts#costMicroUsd). With either left blank, reads still
# work and token counts are still logged — only the cost figure comes back null.
OPENAI_READ_PRICE_INPUT_PER_MTOK="0.20"
OPENAI_READ_PRICE_OUTPUT_PER_MTOK="1.20"

# Writing monthly summaries (Phase 11, D-107). Reuses OPENAI_API_KEY above. Without both this
# and the key set, Write draft summary / Write again stay refused and hidden — the same "as if
# the switch were off" rule as OPENAI_READ_MODEL — but an existing summary already written stays
# readable, editable and downloadable. The live .env is never updated by a deploy; set this there
# by hand.
OPENAI_SUMMARY_MODEL="gpt-5.6-terra"

# Optional. Dollars per 1,000,000 tokens, used only to log an estimated cost per summary
# (src/services/openai/responses.ts#costMicroUsd, feature "summary"). With either left blank,
# writes still work and token counts are still logged — only the cost figure comes back null.
OPENAI_SUMMARY_PRICE_INPUT_PER_MTOK="2.00"
OPENAI_SUMMARY_PRICE_OUTPUT_PER_MTOK="12.00"
