# Production environment for the EC2 deployment. Copy to .env beside
# docker-compose.prod.yml and fill in. Never commit the filled copy.
#
# The app refuses to start in production if any of the first four are missing
# (instrumentation.ts) — a misconfigured deploy fails at boot rather than at first sign-in.

# --- Database -------------------------------------------------------------------------
# Points at the postgres service in this stack, by container name.
POSTGRES_PASSWORD="CHANGE-ME-generate-a-long-random-value"
DATABASE_URL="postgresql://reconciliation:CHANGE-ME-generate-a-long-random-value@reconciliation-postgres:5432/reconciliation"

# --- Session security -----------------------------------------------------------------
# Keys session tokens. Rotating this invalidates every session at once, which is the only
# "sign everybody out" lever there is — use it after a suspected cookie compromise.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# --- Reverse proxy --------------------------------------------------------------------
# Caddy is exactly one hop in front of this app. Login rate limits are keyed on the client
# address; without this every visitor shares one bucket and an attacker's wrong guesses lock
# out the real user. A wrong value is worse than none, because a forged X-Forwarded-For
# would then be trusted.
TRUSTED_PROXY_HOPS="1"

# --- Storage --------------------------------------------------------------------------
# Private bucket, separate from the-pride-api's. The keys belong to an IAM user created for
# this app; the AWS SDK picks these two names up from the environment on its own. (An EC2
# instance role works too, and needs no keys here — but this instance has none attached.)
S3_BUCKET=""
S3_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

# --- Application ----------------------------------------------------------------------
NODE_ENV="production"
APP_URL="https://reconciliation.teampursuit.org"

# Keep closed. Set to "true" only for the one-time creation of the client's organisation,
# then set it back and restart.
SIGNUP_ENABLED="false"
