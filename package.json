{
  "name": "ngo-expenses",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:stripe": "vitest run --config vitest.stripe.config.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:fixture": "tsx --conditions=react-server src/db/dev-fixture.ts",
    "db:reset-password": "tsx --conditions=react-server src/db/reset-password.ts",
    "db:create-staff": "tsx --conditions=react-server src/db/create-staff.ts",
    "db:backup-upload": "tsx --conditions=react-server src/db/backup-upload.ts",
    "db:backup-fetch": "tsx --conditions=react-server src/db/backup-fetch.ts",
    "db:preflight-funding-sources": "tsx --conditions=react-server src/db/preflight-funding-sources.ts",
    "billing:setup": "tsx --conditions=react-server src/modules/billing/scripts/setup.ts",
    "billing:reconcile": "tsx --conditions=react-server src/modules/billing/scripts/reconcile.ts",
    "billing:listen": "tsx --conditions=react-server src/modules/billing/scripts/listen.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1111.0",
    "@node-rs/argon2": "^2.1.0",
    "@tiptap/react": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "docx": "^9.7.1",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "heic-decode": "^2.1.0",
    "next": "16.3.6",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hot-toast": "^2.6.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "stripe": "22.6.2",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
